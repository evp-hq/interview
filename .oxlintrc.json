{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "ignorePatterns": [
        "vendor/**",
        "node_modules/**",
        "public/**",
        "bootstrap/ssr/**",
        "tailwind.config.js",
        "resources/js/actions/**",
        "resources/js/components/ui/*",
        "resources/js/routes/**",
        "resources/js/wayfinder/**"
    ],
    "options": {
        "denyWarnings": true,
        "typeAware": true
    }
}
